[Icon Theme]
Name=NX
Comment=Liquid glass on deep space. Violet folders and the NX mark over Breeze Dark.
Inherits=breeze-dark,breeze,hicolor
DisplayDepth=32
Example=folder
FollowsColorScheme=true

DesktopDefault=48
DesktopSizes=16,22,32,48,64,128,256
ToolbarDefault=22
ToolbarSizes=16,22,32,48
MainToolbarDefault=22
MainToolbarSizes=16,22,32,48
SmallDefault=16
SmallSizes=16,22,32,48
PanelDefault=48
PanelSizes=16,22,32,48,64,128,256
DialogDefault=32
DialogSizes=16,22,32,48,64,128,256

KDE-Extensions=.svg

########## Directories
# NX ships only the icons whose identity is colour: the places/ folder family
# and the NX mark. Everything else -- actions, devices, mimetypes, status,
# emblems, and the 16/22/24px monochrome folder outlines -- is inherited from
# Breeze Dark, which already follows the colour scheme.

Directories=apps/48,places/16,places/22,places/24,places/32,places/48,places/64,places/96

########## Applications

#48x48 - Scalable - The NX mark, used for the launcher / distributor logo
[apps/48]
Size=48
Context=Applications
Type=Scalable
MinSize=48
MaxSize=256

########## Places
########## ordered by size

#16x16 - Fixed size - launcher mark only (the tray variant for -symbolic names)
[places/16]
Size=16
Context=Places
Type=Fixed
MinSize=16

#22x22 - Fixed size - launcher mark only
[places/22]
Size=22
Context=Places
Type=Fixed

#24x24 - Fixed size - launcher mark only
[places/24]
Size=24
Context=Places
Type=Fixed

#32x32 - Fixed size - For folder icons only - Color
[places/32]
Size=32
Context=Places
Type=Fixed

#48x48 - Fixed size - For folder icons only - Color
[places/48]
Size=48
Context=Places
Type=Fixed

#64x64 - Fixed size - For folder icons only - Color
[places/64]
Size=64
Context=Places
Type=Fixed

#96x96 - Scalable - For folder icons only - Scalable to 96, 128 and 256 - Color
[places/96]
Size=96
Context=Places
Type=Scalable
MinSize=96
MaxSize=256
